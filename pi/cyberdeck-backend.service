[Unit]
Description=Cyberdeck backend (FastAPI)
# Mosquitto first: the backend does not reconnect if the broker starts after it
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=__USER__
WorkingDirectory=__PROJECT_DIR__/backend
ExecStart=__PROJECT_DIR__/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
